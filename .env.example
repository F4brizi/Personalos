# ----------------------------------------------------
# Entorno General
# ----------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="Personal OS API"
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ----------------------------------------------------
# Base de Datos PostgreSQL
# ----------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=personal_os_secret
POSTGRES_DB=personal_os_db

# ----------------------------------------------------
# Redis (Caché & Queue)
# ----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ----------------------------------------------------
# Telegram Bot (Ingesta Móvil)
# ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ----------------------------------------------------
# Seguridad
# ----------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_key_in_production
